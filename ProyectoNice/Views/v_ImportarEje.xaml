<Window x:Class="ProyectoNice.Views.v_ImportarEje"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:ProyectoNice.Views.Converters"
        Title="Importar eje desde LandXML" Width="860" Height="620" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Fondo}" Foreground="{DynamicResource Texto}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ProyectoNice;component/Views/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--Encabezado-->
        <Border DockPanel.Dock="Top" Background="{StaticResource Primario}" Padding="20,14">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/ProyectoNice;component/Resources/Icons/ImportarEje32.png" Width="32" Height="32" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Importar eje desde LandXML" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="En Civil 3D: Salida &gt; Exportar a LandXML, marcando el alineamiento y su perfil." Foreground="{StaticResource MenuTexto}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--Botones-->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Background="{StaticResource TextoSuave}" Command="{Binding CancelarBT}" IsCancel="True"/>
                    <Button Content="Crear eje en el modelo" Background="{StaticResource Acento}" Command="{Binding ImportarBT}" IsDefault="True" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--Pasos-->
            <StackPanel Grid.Column="0">
                <GroupBox Header="1  ·  Archivo">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Buscar…" Command="{Binding BuscarArchivoBT}"/>
                        <TextBox Text="{Binding RutaArchivo, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center"
                                 ToolTip="{Binding RutaArchivo}"/>
                    </DockPanel>
                </GroupBox>

                <GroupBox Header="2  ·  Alineamiento y rasante">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Alineamiento" VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding Alineamientos}" SelectedItem="{Binding AlineamientoSelecc}"/>
                        <TextBlock Grid.Row="1" Text="Rasante" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Rasantes}" SelectedItem="{Binding RasanteSelecc}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="3  ·  Ubicación y dibujo">
                    <StackPanel>
                        <RadioButton IsChecked="{Binding UbicarCompartidas}" Content="Coordenadas reales (compartidas)"/>
                        <TextBlock Style="{StaticResource Ayuda}" Text="Recomendado si el modelo ya está georreferenciado con Civil 3D o el levantamiento."/>
                        <RadioButton IsChecked="{Binding UbicarOrigen}" Content="Inicio del eje en el origen del proyecto"/>
                        <TextBlock Style="{StaticResource Ayuda}" Text="Para modelos sin coordenadas. Las cotas se mantienen."/>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Paso de dibujo (m)  " VerticalAlignment="Center" ToolTip="Distancia entre puntos de la polilínea 3D. Menor = más preciso en curvas."/>
                            <TextBox Grid.Column="1" Text="{Binding Paso, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="3" Text="Marcas cada (m)  " VerticalAlignment="Center" ToolTip="Marcas perpendiculares al eje. Cada 100 m la marca es más larga. 0 = sin marcas."/>
                            <TextBox Grid.Column="4" Text="{Binding MarcasCada, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!--Avisos del archivo-->
                <Border Background="{StaticResource AcentoSuave}" BorderBrush="{StaticResource Acento}" BorderThickness="3,0,0,0" Padding="12,8"
                        Visibility="{Binding Avisos.Count, Converter={x:Static conv:Visible.SiHayElementos}}">
                    <ItemsControl ItemsSource="{Binding Avisos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat=⚠ {0}}" TextWrapping="Wrap" Margin="0,1"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!--Vista previa-->
            <GroupBox Grid.Column="2" Header="Vista previa" VerticalAlignment="Top">
                <StackPanel Width="340">
                    <TextBlock Text="Planta (norte arriba)" Style="{StaticResource Subtitulo}" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource Fondo}" CornerRadius="4" Height="190">
                        <Canvas>
                            <Polyline Points="{Binding Planta}" Stroke="{StaticResource Acento}" StrokeThickness="2.5"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Border>

                    <TextBlock Text="Perfil (escala vertical exagerada)" Style="{StaticResource Subtitulo}" Margin="0,10,0,4"/>
                    <Border Background="{StaticResource Fondo}" CornerRadius="4" Height="90">
                        <Canvas>
                            <Polyline Points="{Binding Perfil}" Stroke="{StaticResource PrimarioClaro}" StrokeThickness="2" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Border>
                    <TextBlock Text="{Binding TextoPerfil}" Style="{StaticResource Subtitulo}"/>

                    <TextBlock Text="{Binding Resumen}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
