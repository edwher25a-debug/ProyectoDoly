<Window x:Class="ProyectoDoly.Views.v_EjeDesdeLineas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Titulo}" Width="840" Height="640" MinWidth="660" MinHeight="480"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Fondo}" Foreground="{DynamicResource Texto}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ProyectoDoly;component/Views/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleSi"/>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--Encabezado-->
        <Border DockPanel.Dock="Top" Background="{StaticResource Primario}" Padding="20,14">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/ProyectoDoly;component/Resources/Icons/EjeDesdeLineas32.png" Visibility="{Binding PorLineas, Converter={StaticResource VisibleSi}}" Width="32" Height="32" Margin="0,0,12,0"/>
                <Image DockPanel.Dock="Left" Source="/ProyectoDoly;component/Resources/Icons/EjePorTabla32.png" Visibility="{Binding PorTabla, Converter={StaticResource VisibleSi}}" Width="32" Height="32" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="{Binding Titulo}" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Subtitulo}" Foreground="{StaticResource MenuTexto}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--Botones-->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Background="{StaticResource TextoSuave}" Command="{Binding CancelarBT}" IsCancel="True"/>
                    <Button Content="Crear eje" Background="{StaticResource Acento}" Command="{Binding CrearBT}" IsDefault="True" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="1  ·  Eje">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Nombre  " VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="1" Text="Estación inicial  " VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding EstacionInicial, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Text="Unir extremos a menos de (mm)  " VerticalAlignment="Center" Visibility="{Binding PorLineas, Converter={StaticResource VisibleSi}}"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Width="120" HorizontalAlignment="Left" Text="{Binding Tolerancia, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding PorLineas, Converter={StaticResource VisibleSi}}"/>
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="2" IsChecked="{Binding AlReves}" Margin="0,6,0,0" Visibility="{Binding PorLineas, Converter={StaticResource VisibleSi}}"
                                  Content="Empezar por el otro extremo (el eje empieza donde empieza la primera línea elegida)"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="Puntos de inflexión (PI)" Visibility="{Binding PorTabla, Converter={StaticResource VisibleSi}}">
                    <StackPanel>
                        <TextBox Text="{Binding TablaPi, UpdateSourceTrigger=PropertyChanged}" Height="140" FontFamily="Consolas"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                        <TextBlock Style="{StaticResource Ayuda}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="Un PI por línea: X (Este); Y (Norte); radio; clotoide, en metros y coordenadas compartidas. El primero y el último son el inicio y el fin; en los intermedios va una curva de ese radio con clotoides de ese largo a la entrada y a la salida (0 o vacío = sin clotoide; sin radio = vértice). Se puede pegar desde Excel."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2  ·  Rasante">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton IsChecked="{Binding ConPendiente}" Content="Cota inicial (m)  " VerticalAlignment="Center"/>
                            <TextBox Width="90" Text="{Binding CotaInicial, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConPendiente}"/>
                            <TextBlock Text="   pendiente (%)  " VerticalAlignment="Center"/>
                            <TextBox Width="70" Text="{Binding Pendiente, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConPendiente}" ToolTip="Positiva = sube en el sentido del eje."/>
                        </StackPanel>
                        <RadioButton IsChecked="{Binding ConTabla}" Content="Tabla de PIV" Margin="0,8,0,2"/>
                        <TextBox Text="{Binding TablaPiv, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding ConTabla}" Height="90"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Style="{StaticResource Ayuda}" Margin="0,2,0,0" TextWrapping="Wrap"
                                   Text="Una línea o punto y coma por PIV: estación = cota, y / longitud de la curva vertical si la tiene. Ejemplo: 0+000 = 545.30; 0+120 = 548 / 80; 0+300 = 546.5. Debe cubrir todo el eje."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3  ·  Dibujo">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Marcas de estación cada (m)  " VerticalAlignment="Center"/>
                            <TextBox Width="80" Text="{Binding MarcasCada, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Ayuda}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="El eje se guarda en coordenadas compartidas, igual que uno importado: sirve para Placements, Superestructura, Subestructura y las demás herramientas."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
            </ScrollViewer>

            <GroupBox Grid.Column="2" Header="Vista previa" VerticalAlignment="Top">
                <TextBlock Text="{Binding Resumen}" TextWrapping="Wrap" LineHeight="20"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
