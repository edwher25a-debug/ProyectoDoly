<Window x:Class="ProyectoDoly.Views.v_Superestructura"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Superestructura" Width="880" Height="760" MinWidth="780" MinHeight="680"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Fondo}" Foreground="{DynamicResource Texto}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ProyectoDoly;component/Views/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--Encabezado-->
        <Border DockPanel.Dock="Top" Background="{StaticResource Primario}" Padding="20,14">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/ProyectoDoly;component/Resources/Icons/Superestructura32.png" Width="32" Height="32" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Superestructura" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Barre una sección transversal (familia de Revit) a lo largo del eje, siguiendo la planta y la rasante." Foreground="{StaticResource MenuTexto}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--Botones-->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Background="{StaticResource TextoSuave}" Command="{Binding CancelarBT}" IsCancel="True"/>
                    <Button Content="Crear tablero en el modelo" Background="{StaticResource Acento}" Command="{Binding CrearBT}" IsDefault="True" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!--Pasos-->
            <StackPanel Grid.Column="0">
                <GroupBox Header="1  ·  Eje">
                    <StackPanel>
                        <ComboBox ItemsSource="{Binding Ejes}" SelectedItem="{Binding EjeSelecc}"/>
                        <TextBlock Style="{StaticResource Ayuda}" Margin="0,2,0,0" Text="Ejes creados con Importar eje. Si seleccionó un eje antes de abrir esta ventana, aparece elegido."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="2  ·  Sección transversal">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Cargar familia…" Command="{Binding CargarFamiliaBT}"/>
                            <ComboBox ItemsSource="{Binding Tipos}" SelectedItem="{Binding TipoSelecc}"/>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Ayuda}" Margin="0,2,0,6" Text="Familia de Modelo genérico o Perfil con la sección dibujada de frente. El origen de la familia es el punto del eje sobre la rasante."/>
                        <CheckBox IsChecked="{Binding Espejo}" Content="Reflejar la sección (izquierda ↔ derecha)"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3  ·  Tramo y ubicación">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="24"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Desde estación  " VerticalAlignment="Center" ToolTip="En metros o como 1+234.5"/>
                        <TextBox Grid.Column="1" Text="{Binding EstacionInicial, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Column="3" Text="Hasta estación  " VerticalAlignment="Center" ToolTip="En metros o como 1+234.5"/>
                        <TextBox Grid.Column="4" Text="{Binding EstacionFinal, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="1" Text="Paso entre secciones (m)  " VerticalAlignment="Center"
                                   ToolTip="Distancia máxima entre secciones del barrido. Menor = curvas más suaves. Siempre hay sección en cada cambio de recta, curva o clotoide."/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Paso, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="2" Text="Desplazar a la derecha (m)  " VerticalAlignment="Center" ToolTip="Negativo = hacia la izquierda del eje."/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DesplazamientoLateral, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="Subir (m)  " VerticalAlignment="Center" ToolTip="Negativo = bajar la sección respecto a la rasante (por ejemplo, el espesor del pavimento)."/>
                        <TextBox Grid.Row="2" Grid.Column="4" Text="{Binding DesplazamientoVertical, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                </GroupBox>

                <GroupBox Header="4  ·  Cómo se crea">
                    <StackPanel>
                        <RadioButton IsChecked="{Binding FamiliaAdaptativa}" Content="Familia adaptativa (como SOFiSTiK)"/>
                        <TextBlock Style="{StaticResource Ayuda}" Text="Un ejemplar por tramo con la sección en sus puntos adaptativos y una solevación sólida. Se puede editar, tiene material y queda agrupado."/>
                        <RadioButton IsChecked="{Binding SolidoDirecto}" Content="Sólido directo (DirectShape)"/>
                        <TextBlock Style="{StaticResource Ayuda}" Text="Un solo elemento, más rápido, pero no editable."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <!--Vista previa-->
            <GroupBox Grid.Column="2" Header="Vista previa" VerticalAlignment="Top">
                <StackPanel Width="340">
                    <TextBlock Text="Sección mirando en el sentido del eje" Style="{StaticResource Subtitulo}" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource Fondo}" CornerRadius="4" Height="200" ClipToBounds="True">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Formas}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polygon x:Name="Forma" Points="{Binding Puntos}" Fill="{StaticResource AcentoSuave}"
                                                 Stroke="{StaticResource Acento}" StrokeThickness="1.5" StrokeLineJoin="Round"/>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding EsHueco}" Value="True">
                                                <Setter TargetName="Forma" Property="Fill" Value="{StaticResource Fondo}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!--Punto del eje sobre la rasante-->
                            <Canvas>
                                <Ellipse Width="9" Height="9" Fill="{StaticResource Primario}" Canvas.Left="{Binding OrigenX}" Canvas.Top="{Binding OrigenY}">
                                    <Ellipse.RenderTransform>
                                        <TranslateTransform X="-4.5" Y="-4.5"/>
                                    </Ellipse.RenderTransform>
                                </Ellipse>
                            </Canvas>
                        </Grid>
                    </Border>
                    <TextBlock Style="{StaticResource Subtitulo}" Text="● punto del eje (rasante)"/>

                    <TextBlock Text="{Binding Resumen}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
