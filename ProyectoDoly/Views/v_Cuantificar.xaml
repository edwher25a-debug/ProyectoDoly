<Window x:Class="ProyectoDoly.Views.v_Cuantificar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cuantificar" Width="760" Height="520" MinWidth="640" MinHeight="440"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Fondo}" Foreground="{DynamicResource Texto}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ProyectoDoly;component/Views/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--Encabezado-->
        <Border DockPanel.Dock="Top" Background="{StaticResource Primario}" Padding="20,14">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/ProyectoDoly;component/Resources/Icons/Cuantificar32.png" Width="32" Height="32" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Cuantificar" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Escribe estaciones, placement, desfase y volumen de cada elemento en parámetros compartidos." Foreground="{StaticResource MenuTexto}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--Botones-->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Background="{StaticResource TextoSuave}" Command="{Binding CancelarBT}" IsCancel="True"/>
                    <Button Content="Cuantificar" Background="{StaticResource Acento}" Command="{Binding CrearBT}" IsDefault="True" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="230"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <GroupBox Header="1  ·  Eje de referencia">
                    <ComboBox ItemsSource="{Binding Ejes}" SelectedItem="{Binding EjeSelecc}"/>
                </GroupBox>

                <GroupBox Header="2  ·  Elementos">
                    <StackPanel>
                        <RadioButton IsChecked="{Binding UsarSeleccion}" IsEnabled="{Binding HaySeleccion}" Content="{Binding TextoSeleccion}" Margin="0,2"/>
                        <RadioButton IsChecked="{Binding UsarCreados}" Content="{Binding TextoCreados}" Margin="0,2"/>
                        <TextBlock Style="{StaticResource Ayuda}" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Text="Las estaciones salen de proyectar la geometría de cada elemento sobre el eje. El placement es el ID si el elemento está en uno, o P1-P2 si ocupa ese vano. El desfase es positivo a la derecha del eje. Vuelva a cuantificar si mueve el eje o los elementos."/>
                    </StackPanel>
                </GroupBox>
            </StackPanel>

            <GroupBox Grid.Column="2" Header="Parámetros que se escriben" VerticalAlignment="Top">
                <TextBlock Text="{Binding Parametros}" TextWrapping="Wrap" LineHeight="20"/>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
