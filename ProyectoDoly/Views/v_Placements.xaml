<Window x:Class="ProyectoDoly.Views.v_Placements"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Placements del eje" Width="900" Height="680" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Background="{DynamicResource Fondo}" Foreground="{DynamicResource Texto}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/ProyectoDoly;component/Views/Estilos.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <DockPanel>
        <!--Encabezado-->
        <Border DockPanel.Dock="Top" Background="{StaticResource Primario}" Padding="20,14">
            <DockPanel>
                <Image DockPanel.Dock="Left" Source="/ProyectoDoly;component/Resources/Icons/Placements32.png" Width="32" Height="32" Margin="0,0,12,0"/>
                <StackPanel>
                    <TextBlock Text="Placements del eje" Foreground="White" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="Puntos con nombre a lo largo del eje: ejes de apoyo, juntas, inicio y fin de tablero. Las pilas, estribos y vanos se colocan en ellos." Foreground="{StaticResource MenuTexto}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!--Botones-->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Borde}" BorderThickness="0,1,0,0" Padding="20,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Cancelar" Background="{StaticResource TextoSuave}" Command="{Binding CancelarBT}" IsCancel="True"/>
                    <Button Content="Guardar en el eje" Background="{StaticResource Acento}" Command="{Binding GuardarBT}" IsDefault="True" FontWeight="SemiBold"/>
                </StackPanel>
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Error}" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <Grid Margin="20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <GroupBox DockPanel.Dock="Top" Header="1  ·  Eje">
                    <ComboBox ItemsSource="{Binding Ejes}" SelectedItem="{Binding EjeSelecc}"/>
                </GroupBox>

                <GroupBox DockPanel.Dock="Top" Header="2  ·  Agregar varios">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Desde  " VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding DistribuirDesde, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="2" Text="  hasta  " VerticalAlignment="Center"/>
                            <TextBox Grid.Column="3" Text="{Binding DistribuirHasta, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="4" Text="  cada (m)  " VerticalAlignment="Center"/>
                            <TextBox Grid.Column="5" Text="{Binding DistribuirCada, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Grid.Column="6" Text="  prefijo  " VerticalAlignment="Center"/>
                            <TextBox Grid.Column="7" Text="{Binding Prefijo, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="8" HorizontalAlignment="Right" Content="Agregar" Command="{Binding DistribuirBT}"/>
                        </Grid>
                        <TextBlock Style="{StaticResource Ayuda}" Margin="0,2,0,0" Text="Por ejemplo, un placement por cada eje de pila. El final siempre lleva placement. No se repiten estaciones que ya existen."/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="3  ·  Placements">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Agregar uno" Command="{Binding AgregarBT}"/>
                            <Button Content="Quitar" Background="{StaticResource TextoSuave}" Command="{Binding QuitarBT}"/>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Ayuda}" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Text="Estación en metros o como 0+120. Giro en grados respecto a la perpendicular al eje (+ antihorario en planta): 0 = apoyo recto, otro valor = apoyo esviado."/>
                        <DataGrid ItemsSource="{Binding Filas}" SelectedItem="{Binding FilaSelecc}" AutoGenerateColumns="False" CanUserAddRows="False"
                                  CanUserDeleteRows="False" HeadersVisibility="Column" SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridTextColumn Header="Estación" Binding="{Binding Estacion, UpdateSourceTrigger=LostFocus}" Width="*"/>
                                <DataGridTextColumn Header="Giro (°)" Binding="{Binding Rotacion, UpdateSourceTrigger=LostFocus}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </GroupBox>
            </DockPanel>

            <!--Vista previa-->
            <GroupBox Grid.Column="2" Header="Vista previa" VerticalAlignment="Top">
                <StackPanel Width="360">
                    <TextBlock Text="Planta (norte arriba)" Style="{StaticResource Subtitulo}" Margin="0,0,0,4"/>
                    <Border Background="{StaticResource Fondo}" CornerRadius="4" Height="260" ClipToBounds="True">
                        <Grid>
                            <Canvas>
                                <Polyline Points="{Binding Planta}" Stroke="{StaticResource PrimarioClaro}" StrokeThickness="2" StrokeLineJoin="Round"/>
                            </Canvas>
                            <ItemsControl ItemsSource="{Binding Marcas}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Canvas>
                                            <Line X1="{Binding X1}" Y1="{Binding Y1}" X2="{Binding X2}" Y2="{Binding Y2}" Stroke="{StaticResource Acento}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            <TextBlock Text="{Binding Texto}" Canvas.Left="{Binding TextoX}" Canvas.Top="{Binding TextoY}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Primario}"/>
                                        </Canvas>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <TextBlock Text="{Binding Resumen}" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20"/>
                    <TextBlock Style="{StaticResource Subtitulo}" TextWrapping="Wrap"
                               Text="En el modelo, cada placement se dibuja en el eje como una línea de 12 m en su plano y un poste vertical de 3 m."/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
